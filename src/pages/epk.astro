---
import c from '../../public/content.json';
import '../styles/site.css';
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Nash Turbeville | Electronic Press Kit</title><meta name="description" content="Nash Turbeville’s performance profile, solo and dueling piano formats, repertoire, and booking contact."/><link rel="canonical" href="https://nashmusic.org/epk/"/><meta property="og:title" content="Nash Turbeville | Electronic Press Kit"/><meta property="og:type" content="profile"/></head><body>
<header><a class="brand" href="/">NASH TURBEVILLE</a><nav aria-label="Press kit navigation"><a href="/booking/">Booking</a><a href="/requests/">Repertoire</a><a href="/contact/">Contact</a></nav></header>
<main class="section epk"><p class="eyebrow">PERFORMANCE PROFILE / ELECTRONIC PRESS KIT</p><h1>Nash Turbeville</h1><p class="lead">Singing pianist & dueling pianist</p>{c.portrait&&<img class="epk-portrait" src={c.portrait} alt="Nash Turbeville performing"/>}<p>{c.bio}</p>
<div class="actions no-print"><a class="button primary" href={`mailto:${c.bookingEmail}`}>Discuss a booking ↗</a><button class="button outline" id="print-epk">Print / save as PDF ↓</button></div>
<section><h2>Performance experience</h2><ul><li>Cruise ship singing pianist</li><li>Cruise ship dueling pianist</li><li>Performer with J’s Dueling Pianos</li></ul></section>
<section><h2>Performance formats</h2><p><strong>Solo singing piano:</strong> Live vocals and piano with an audience-focused repertoire.</p><p><strong>Dueling pianos:</strong> Interactive entertainment with audience requests and singalongs. Contact Nash to discuss the performers and arrangements for your event.</p></section>
<section><h2>Repertoire</h2><p>{c.songs.length} songs across pop, rock, country, R&B/soul, jazz standards, Broadway and film, and more.</p><a class="text-link" href="https://nashmusic.org/requests/">Browse the full repertoire at nashmusic.org/requests ↗</a></section>
{c.videos.length>0&&<section><h2>Watch Nash perform</h2>{c.videos.map(v=><p><strong>{v.type}: </strong><a class="text-link" href={v.url}>{v.title} ↗</a></p>)}</section>}
{c.travelAvailability&&<section><h2>Availability & travel</h2><p>{c.travelAvailability}</p></section>}{c.equipment&&<section><h2>Piano & sound</h2><p>{c.equipment}</p></section>}
<section><h2>Booking</h2><p>Share your date, location, venue or ship, audience, and preferred performance format.</p><p><a href={`mailto:${c.bookingEmail}`}>{c.bookingEmail}</a><br/><a href="https://nashmusic.org/">nashmusic.org</a></p></section>
<section><h2>Private teaching</h2><p>{c.teachingBio}</p><a href={`mailto:${c.teachingEmail}`}>{c.teachingEmail}</a></section></main>
<script>document.querySelector('#print-epk')?.addEventListener('click',()=>window.print());</script>
<style>.epk{max-width:950px}.epk h1{margin-bottom:15px}.epk section{margin-top:40px}.epk section h2{font-size:30px;margin-bottom:18px}.epk-portrait{max-width:300px;max-height:350px;object-fit:cover;margin:20px 0}@media print{header,.no-print{display:none!important}body{background:white;color:black}.epk{padding:0}.epk h1{font-size:40px}.epk section{break-inside:avoid;margin-top:20px}.epk section h2{font-size:23px}.epk a{overflow-wrap:anywhere}}
</style></body></html>
